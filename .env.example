# Copy this file to .env and fill in your own domain(s) before running
# `docker compose up -d --build`.

# Port the backend (Socket.IO server) listens on inside its container.
BACKEND_PORT=13797

# Comma-separated list of origins allowed to connect to the backend
# (the URL the game frontend is served from). Use the public URL
# players' browsers will use, e.g.:
#   CORS_ORIGIN=https://game.example.com
CORS_ORIGIN=http://localhost:8080

# Public URL of the backend that the game frontend's browser bundle will
# connect to. This is baked into the frontend at build time, so changing
# it requires rebuilding the game image.
REACT_APP_BACKEND_URL=http://localhost:13797

# Host ports to publish for each service.
GAME_PORT=8080
